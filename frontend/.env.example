# Frontend env — optional. By default the app calls same-origin
# /api/backend/* and Vercel rewrites that to the Render backend.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Optional server-side rewrite target for Vercel/Next.
BACKEND_API_URL=https://gr-hack.onrender.com

# Direct local backend alternative:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
